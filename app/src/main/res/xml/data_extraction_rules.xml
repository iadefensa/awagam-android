<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing this app stores leaves the device. Which blocklists someone
    subscribes to is the most telling thing here, and it is not ours to copy
    into anyone’s cloud account; `Export config` under Settings hands the user
    the same data to put wherever they choose.

    `android:allowBackup="false"` alone would not be enough: on Android 12 and
    later it stops cloud backup, but device-to-device transfer still runs unless
    it is excluded here too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
