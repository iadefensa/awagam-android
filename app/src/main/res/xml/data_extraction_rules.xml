<?xml version="1.0" encoding="utf-8"?>
<!--
    Same scope as `backup_rules.xml`, for Android 12 and later: blocklist
    configurations and user settings transfer, fetched rules and statistics
    do not.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/blocklists.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/blocklists.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
