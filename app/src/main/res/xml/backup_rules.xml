<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below, where `android:allowBackup="false"` already disables
    backup outright. Stated anyway, so the intent does not rest on that
    attribute alone, and so it survives anyone turning backup back on.
    See `data_extraction_rules.xml` for Android 12 and later.
-->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>
